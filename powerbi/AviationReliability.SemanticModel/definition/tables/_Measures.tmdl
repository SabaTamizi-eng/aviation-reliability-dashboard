	measure 'Powerplant Share' = DIVIDE ( [Powerplant Reports], CALCULATE ( [Reports], REMOVEFILTERS ( 'System' ) ) )
		formatString: 0.0%
		displayFolder: Findings
		lineageTag: 69ac38a8-961c-59fc-bd35-8f43a933b13c

	measure 'Borescope Findings' = CALCULATE ( [Reports], 'Discovery Method'[Method Code] = "B" )
		formatString: #,0
		displayFolder: Findings
		lineageTag: 40895e9d-4d57-5a0c-9636-174a4f7b6794

	measure 'NDT Share' = DIVIDE ( CALCULATE ( [Reports], 'Discovery Method'[Method Group] = "NDT & borescope" ), [Reports] )
		formatString: 0.0%
		displayFolder: Findings
		lineageTag: d9ae3442-d14d-5614-ba69-696aefdf0ac1

	measure 'Median Airframe Hours' = MEDIAN ( SDR[Airframe Hours] )
		formatString: #,0
		displayFolder: Findings
		lineageTag: b91095e2-f8b9-50e9-92a2-ce7e036ca01f

	measure 'Engine Manufacturer Reported Share' = DIVIDE ( CALCULATE ( [Reports], SDR[Engine Make Code] <> "NR" ), [Reports] )
		formatString: 0%
		displayFolder: Findings
		lineageTag: 81ac6fcf-6a15-5474-970f-e98aeaa4d0aa

	measure 'Top 3 Chapters Share' =
			VAR TopChapters = TOPN ( 3, ADDCOLUMNS ( VALUES ( 'System'[Chapter] ), "@Reports", [Reports] ), [@Reports], DESC )
			RETURN
			    DIVIDE ( SUMX ( TopChapters, [@Reports] ), [Reports] )
		formatString: 0%
		displayFolder: Pareto
		lineageTag: 5450a581-ca0f-51d9-ba5e-e748836180c6

	measure 'Chapters for 80%' =
			VAR ChapterTable = ADDCOLUMNS ( VALUES ( 'System'[Chapter] ), "@Reports", [Reports] )
			VAR AllReports = SUMX ( ChapterTable, [@Reports] )
			VAR WithRunning =
			    ADDCOLUMNS (
			        ChapterTable,
			        "@Running",
			            VAR ThisChapter = [@Reports]
			            RETURN SUMX ( FILTER ( ChapterTable, [@Reports] >= ThisChapter ), [@Reports] )
			    )
			RETURN
			    COUNTROWS ( FILTER ( WithRunning, [@Running] - [@Reports] < 0.8 * AllReports ) )
		formatString: 0
		displayFolder: Pareto
		lineageTag: bf3071f5-ea59-59c5-8371-b5e6e9130935

	measure 'Median Days to Submit' = MEDIAN ( SDR[Days to Submit] )
		formatString: 0
		displayFolder: Reporting
		lineageTag: f1af80c8-09d8-57d2-b633-d5a4acf53d93

	measure 'Submitted Within 7 Days' =
			DIVIDE (
			    CALCULATE ( [Reports], SDR[Days to Submit] <= 7 ),
			    CALCULATE ( [Reports], NOT ISBLANK ( SDR[Days to Submit] ) )
			)
		formatString: 0%
		displayFolder: Reporting
		lineageTag: b0a9e57e-6ee4-547f-a221-8841c9b7c425

	measure 'Pareto Cumulative Share' =
			VAR CurrentReports = [Reports]
			// Chapter is sorted by Chapter Code, so the visual filters both columns; clear both to rank every chapter
			VAR ChapterTable =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( 'System'[Chapter] ), "@Reports", [Reports] ),
			        REMOVEFILTERS ( 'System'[Chapter], 'System'[Chapter Code] )
			    )
			VAR RunningTotal = SUMX ( FILTER ( ChapterTable, [@Reports] >= CurrentReports ), [@Reports] )
			RETURN
			    IF ( NOT ISBLANK ( CurrentReports ), DIVIDE ( RunningTotal, SUMX ( ChapterTable, [@Reports] ) ) )
		formatString: 0%
		displayFolder: Pareto
		lineageTag: b1c89720-d48a-53ea-b77d-7d7e8225e0ed

	measure 'Chapter Share' = DIVIDE ( [Reports], CALCULATE ( [Reports], REMOVEFILTERS ( 'System'[Chapter], 'System'[Chapter Code] ) ) )
		formatString: 0.0%
		displayFolder: Pareto
		lineageTag: 030664fc-0748-5d6d-b46d-935b6e1f988c

	measure 'Pareto Bar Color' =
			VAR PriorShare = [Pareto Cumulative Share] - [Chapter Share]
			RETURN
			    IF ( PriorShare < 0.8, "#1D4E89", "#B9C6D6" )
		displayFolder: Pareto
		lineageTag: dc4ac544-dd81-5e64-a665-1b7fd00b59f2

	measure 'Period Label' =
			VAR FirstYear = MIN ( 'Date'[Year] )
			VAR LastYear = MAX ( 'Date'[Year] )
			RETURN
			    IF ( FirstYear = LastYear, FORMAT ( FirstYear, "0" ), FORMAT ( FirstYear, "0" ) & "-" & FORMAT ( LastYear, "0" ) )
		displayFolder: Labels
		lineageTag: 82a99222-7fa7-5de5-a496-57c18a7e68d4

	measure 'Header Subtitle' = "FAA Service Difficulty Reports  ·  " & [Period Label] & "  ·  " & FORMAT ( [Reports], "#,0" ) & " reports"
		displayFolder: Labels
		lineageTag: 36e1b1f1-a6ef-56ee-a982-994d46e49f2b

	measure 'Reports YoY Label' =
			VAR LatestYear = [Latest Year]
			VAR Change = CALCULATE ( [Reports], 'Year Comparison'[Comparison] = "Change %" )
			RETURN
			    IF (
			        ISBLANK ( Change ),
			        "No earlier year selected",
			        FORMAT ( LatestYear, "0" ) & ": " & IF ( Change >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( Change ), "0.0%" ) & " vs " & FORMAT ( LatestYear - 1, "0" )
			    )
		displayFolder: Labels
		lineageTag: e3931f4d-62fd-5a27-940a-27fe504cc9fb

	measure 'Unscheduled Landings YoY Label' =
			VAR LatestYear = [Latest Year]
			VAR Change = CALCULATE ( [Unscheduled Landings], 'Year Comparison'[Comparison] = "Change %" )
			RETURN
			    IF (
			        ISBLANK ( Change ),
			        "No earlier year selected",
			        FORMAT ( LatestYear, "0" ) & ": " & IF ( Change >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( Change ), "0.0%" ) & " vs " & FORMAT ( LatestYear - 1, "0" )
			    )
		displayFolder: Labels
		lineageTag: f6035210-a40d-5a93-b0ef-710d1588d348

	measure 'Engine Shutdowns YoY Label' =
			VAR LatestYear = [Latest Year]
			VAR Change = CALCULATE ( [Engine Shutdowns], 'Year Comparison'[Comparison] = "Change %" )
			RETURN
			    IF (
			        ISBLANK ( Change ),
			        "No earlier year selected",
			        FORMAT ( LatestYear, "0" ) & ": " & IF ( Change >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( Change ), "0.0%" ) & " vs " & FORMAT ( LatestYear - 1, "0" )
			    )
		displayFolder: Labels
		lineageTag: 0b72e7bc-a67d-5b94-a3a4-0cde4af142e3

	measure 'Powerplant YoY Label' =
			VAR LatestYear = [Latest Year]
			VAR Change = CALCULATE ( [Powerplant Reports], 'Year Comparison'[Comparison] = "Change %" )
			RETURN
			    IF (
			        ISBLANK ( Change ),
			        "No earlier year selected",
			        FORMAT ( LatestYear, "0" ) & ": " & IF ( Change >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( Change ), "0.0%" ) & " vs " & FORMAT ( LatestYear - 1, "0" )
			    )
		displayFolder: Labels
		lineageTag: cf232116-ab3b-5cd2-b0f0-8f7a46f59a0b

	measure 'In-Flight Label' = FORMAT ( [In-Flight Reports], "#,0" ) & " reports in flight"
