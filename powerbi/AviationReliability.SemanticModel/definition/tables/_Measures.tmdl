table _Measures
	lineageTag: 6f828c8d-8bd0-51fe-8ecf-3908226d01fe

	measure Reports = COUNTROWS ( SDR )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 54a51d59-9dfd-5dfc-b8e8-2dd3a41d7f8f

	measure 'Aircraft Reporting' = CALCULATE ( DISTINCTCOUNT ( SDR[Registration] ), NOT ISBLANK ( SDR[Registration] ) )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 199c31dd-d3d6-5055-93f0-8f9bb91d46bc

	measure 'Reports per Aircraft' = DIVIDE ( [Reports], [Aircraft Reporting] )
		formatString: 0.0
		displayFolder: Volume
		lineageTag: 33167d7d-f189-5de5-9284-54d8872f2ff3

	measure 'Share of Reports' = DIVIDE ( [Reports], CALCULATE ( [Reports], ALLSELECTED () ) )
		formatString: 0.0%
		displayFolder: Volume
		lineageTag: 88fff23e-745d-5bc3-bdd3-22226f7743dd

	measure 'Avg Reports per Month' = AVERAGEX ( VALUES ( 'Date'[Year Month Key] ), [Reports] )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 0d83263c-3945-5c46-ad74-e03227c99ad1

	measure 'Reports Prior Year' = CALCULATE ( [Reports], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 9bbbe9ff-9411-5bbf-9820-a4433a96506b

	measure 'Latest Year' = MAX ( 'Date'[Year] )
		formatString: 0
		displayFolder: Volume
		lineageTag: b648962a-aea1-5d52-95dc-5000dfc17281

	measure 'Reports YoY %' = CALCULATE ( [Reports], 'Year Comparison'[Comparison] = "Change %" )
		formatString: +0.0%;-0.0%;0.0%
